# Copy this file to .env for local overrides. Never commit real values.

# Port the API listens on.
PORT=3000

# Leave DATABASE_URL empty for local development: the app then uses an embedded
# Postgres (PGlite) stored in ./data. Production requires a real Postgres URL.
DATABASE_URL=

# 64 hexadecimal characters (32 bytes). Required in production. It encrypts shared files.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# The administrator account. On every start the server makes sure this account
# exists, has this password, and has administrator rights.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# When true (the default), only helpers an administrator has verified can be
# matched, offer help, or receive files.
REQUIRE_VERIFIED_HELPERS=true
